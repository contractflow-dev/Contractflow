# Copy to apps/api/.env for local development. Never commit real secrets.

# --- Runtime ---
NODE_ENV=development
PORT=3001

# --- Database ---
DATABASE_URL=postgres://contractflow:contractflow@localhost:5432/contractflow
# true when using a hosted database that requires SSL
DB_SSL=false

# --- Web / CORS ---
WEB_URL=http://localhost:3000
# comma-separated; defaults to WEB_URL
CORS_ORIGIN=

# --- Auth ---
# At least 32 characters in development.
JWT_SECRET=replace-with-a-long-random-development-secret

# --- Mail ---
MAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# --- Document storage (Amazon S3) ---
# Required. Credentials are NOT configured here: the AWS SDK default
# credential chain is used (the ECS task role in production; an AWS CLI
# profile or SSO session locally, e.g. `aws sso login --profile contractflow`
# then run the API with AWS_PROFILE=contractflow).
AWS_REGION=eu-north-1
S3_BUCKET_NAME=contractflow-app-storage-191518190571

# Optional S3-compatible endpoint for local development (for example MinIO).
# Leave unset to use Amazon S3. Path-style addressing defaults to on when set.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=

# Optional upload/download policy (defaults shown).
# Maximum upload size in bytes (25 MB).
DOCUMENT_MAX_UPLOAD_BYTES=26214400
# Presigned PUT lifetime in seconds (60-3600).
DOCUMENT_UPLOAD_URL_TTL_SECONDS=300
# Presigned GET lifetime in seconds (10-900).
DOCUMENT_DOWNLOAD_URL_TTL_SECONDS=60

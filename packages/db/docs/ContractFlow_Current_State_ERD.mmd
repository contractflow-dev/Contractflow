    CONTRACT_PARTY_INVITATION {
        varchar(26) id PK
        varchar(26) source_contract_party_id FK
        varchar(26) source_company_id FK "part of both composite FKs"
        varchar(26) target_company_id FK
        varchar(26) invited_by_company_user_id FK
        varchar(26) accepted_by_company_user_id FK "nullable"
        varchar(20) party_type "awarded (CHECK): an invited company is the awarded party"
        varchar(320) email
        varchar(64) token_hash UK
        varchar(20) status "pending | accepted | rejected | expired | revoked (CHECK), default pending"

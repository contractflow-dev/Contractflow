    %% Contract -----------------------------------------------------------------
    %% UNIQUE UQ_4eb2644094e921caea38a4fe908 (reference_number)
    %% No owning-company column: ownership and visibility come from CONTRACT_PARTY.
    %% A subcontract is a separate contract whose parent is a main contract.
    %% CHECK ck_contract_not_own_parent (parent_contract_id <> id)
    %% TRIGGER contract_parent_rules: the parent must be a main contract (one
    %%   level, so no cycles) and parent_contract_id can't change after insert.
    %% When a contract completed is its CONTRACT_STATUS_HISTORY entry.
    CONTRACT {
        varchar(26) id PK
        varchar(40) reference_number UK
        varchar(255) title
        text description "nullable"
        enum contract_type "service | supply | epc | maintenance"
        enum status "draft | active | suspended | completed"
        varchar(26) parent_contract_id FK "nullable; the main contract of a subcontract, fixed"
        bigint original_value_minor
        bigint current_value_minor
        char(3) currency_code
        int retention_rate_bps
        int advance_payment_rate_bps "nullable"
        int payment_terms_days
        bigint liquidated_damages_per_day_minor "nullable"
        date award_date
        date start_date
        date end_date
        date revised_end_date "nullable"
        int defects_liability_days
        varchar(64) timezone
        varchar(26) created_by_company_id FK "nullable"
        timestamptz deleted_at "nullable, archived (soft delete)"
        varchar(26) deleted_by_company_user_id FK "nullable"
    }
    %% UNIQUE uq_contract_party_id_company (id, company_id), target of composite FKs
    %% UNIQUE uq_contract_party_contract_company (contract_id, company_id)
    %% UNIQUE uq_contract_party_one_awarding (contract_id) WHERE party_type = awarding
    %% UNIQUE uq_contract_party_one_awarded (contract_id) WHERE party_type = awarded
    %% TRIGGER contract_party_rules: on a subcontract, the awarding party is the
    %%   main contract's awarded party, and the main contract's awarding party
    %%   (the client) can't be a party.
    %% A contract is between two companies: the awarding and the awarded party.
    CONTRACT_PARTY {
        varchar(26) id PK
        varchar(26) contract_id FK
        varchar(26) company_id FK
        enum party_type "awarding | awarded"
        varchar(100) signatory_first_name "nullable"
        varchar(100) signatory_last_name "nullable"
        varchar(150) signatory_title "nullable"
        timestamptz signed_at "nullable"
    }

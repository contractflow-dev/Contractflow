        varchar(26) entity_id "ULID (CHECK), polymorphic, no FK"
        enum channel "push | sms | email"
        enum status "sent | delivered | pending | failed | read, default pending"
        timestamptz sent_at "NOT NULL in the database"
        timestamptz read_at "NOT NULL in the database"
    }
    %% parent_comment_id NOT NULL: a first, top-level comment cannot be stored as the schema stands.
    %% CHECK ck_comment_entity_id_ulid
    COMMENT {
        varchar(26) id PK
        varchar(26) contract_id FK
        varchar(26) author_company_user_id FK
        varchar(26) parent_comment_id FK "NOT NULL in the database"
        enum entity_type "contract | document | comment | other"
        varchar(26) entity_id "ULID (CHECK), polymorphic, no FK"
        varchar body
        enum visibility "public | private"
    }
    CONVERSATION {
        varchar(26) id PK
        enum conversation_type "comment | message"
        varchar(26) contract_id FK "NOT NULL in the database"
        enum workspace "project | finance | hse; NOT NULL in the database"
        varchar(126) title "NOT NULL in the database"
        timestamptz conversation_created_at
        varchar(26) created_by_id FK "-> company_user"
    }
    CONVERSATION_PARTICIPANT {
        varchar(26) id PK
        varchar(26) conversation_id FK
        varchar(26) company_user_id FK
        timestamptz joined_at
        timestamptz left_at "NOT NULL in the database"
        timestamptz last_read_at "NOT NULL in the database"
    }
    MESSAGE {
        varchar(26) id PK
        varchar(26) conversation_id FK
        varchar(26) sender_company_user_id FK
        text body
        jsonb attachements "spelled attachements in the database"
        timestamptz sent_at
        timestamptz edited_at "NOT NULL in the database"
        timestamptz deleted_at "NOT NULL in the database"
    }
